# Credentials -- never commit.
.env

# Raw and intermediate data is reproducible from scripts/, with one
# exception: the Loughran-McDonald dictionary is vendored so the repo runs
# out of the box without a third-party download.
data/**
!data/
!data/*/
!data/**/.gitkeep
!data/lexicons/
!data/lexicons/LoughranMcDonald_MasterDictionary.csv

__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
.DS_Store

# Exhibits are regenerated by build_report.py, but the report itself and the
# Markdown tables are committed as the deliverable.
outputs/*
!outputs/.gitkeep
!outputs/Assignment4_Report.pdf
!outputs/table1.md
!outputs/table2.md
!outputs/table3.md
